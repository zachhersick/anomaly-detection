
FROM python:3.11-slim

WORKDIR /app

# Install uv
RUN pip install --no-cache-dir uv

# Copy dependency definitions and application source
COPY pyproject.toml uv.lock ./
COPY src/ ./src/

# Install locked production dependencies for the API
RUN uv sync --locked --no-dev --extra api --python /usr/local/bin/python

# Make the virtual environment executables available
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# Start FastAPI using the new package path
CMD ["uvicorn", "anomaly_detection.api:app", "--host", "0.0.0.0", "--port", "8000"]


FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY src/ ./src/

RUN uv sync --locked --no-dev --extra dashboard --python /usr/local/bin/python

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "src/anomaly_detection/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
